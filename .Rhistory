m2 <- lm(count2 ~ spray,
data = inseticida)
summary(m2)
anova(m2)
library(emmeans)
m2_medias <- emmeans(m2, ~ spray)
plot(m2_medias)
library(multcomp)
cld(m2_medias)
pwpm(m2_medias)
pwpp(m2_medias)
pairs(m2_medias)
m2$residuals
hist(m2$residuals)
qqnorm(m2$residuals)
qqline(m2$residuals)
shapiro.test(m2$residuals)
bartlett.test(count2 ~ spray,
data = inseticida)
library(performance)
check_normality(m2)
check_heteroscedasticity(m2)
library(DHARMa)
plot(simulateResiduals(m2))
